# 仅维护旧数据库时需要；当前页面临时浏览流程不使用数据库。
DATABASE_URL=""
DIRECT_URL=""

# 选择 deepseek 或 openai；新部署使用 AI_API_KEY。
AI_PROVIDER="deepseek"
AI_API_KEY=""
# 可选：覆盖所选服务商的默认模型。
AI_MODEL=""
# 兼容旧 DeepSeek 部署；OpenAI 服务商不会读取此旧变量。
OPENAI_API_KEY=""
# false 只关闭 AI，仍可抓取新闻并临时显示在当前页面。
ENABLE_AI=true

# 旧定时任务已停用，保留旧变量仅作维护说明。
CRON_SECRET=""
# 管理员手动操作使用独立密钥，不能以 NEXT_PUBLIC_ 开头。
ADMIN_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
